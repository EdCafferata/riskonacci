    "If it saves your team time, a small tip is always appreciated — never required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es deinem Team Zeit spart, ist ein kleines Trinkgeld immer willkommen – nie verpflichtend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le ahorra tiempo a tu equipo, una pequeña propina siempre es bienvenida, nunca obligatoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cela fait gagner du temps à votre équipe, un petit pourboire est toujours apprécié — jamais obligatoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se fa risparmiare tempo al tuo team, una piccola mancia è sempre apprezzata — mai obbligatoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームの時間を節約できたなら、少額のチップはいつでも歓迎です — 必須ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀의 시간을 절약해 준다면 작은 팁은 언제나 환영입니다 — 필수는 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het je team tijd bespaart, is een kleine fooi altijd welkom — nooit verplicht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poupar tempo à sua equipa, uma pequena gorjeta é sempre bem-vinda — nunca obrigatória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это экономит время вашей команде, небольшие чаевые всегда приветствуются — но никогда не обязательны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果它为你的团队节省了时间，欢迎给一点小费——但绝不强制。"
          }
        }
      }
    },
